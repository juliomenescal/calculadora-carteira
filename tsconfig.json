{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/InvestmentCalculator.tsx",
    "components/AssetCard.tsx",
    "components/Results.tsx",
    "components/PortfolioSummary.tsx",
    "components/ui/alert-dialog.tsx",
    "components/ui/button.tsx",
    "lib/optimizer.ts",
    "lib/optimizer.test.ts",
    "lib/storage.ts",
    "lib/formatters.ts",
    "lib/utils.ts",
    "types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "build",
    "scripts"
  ]
}
